# Copy to .env and edit. Read by the API, by the TypeORM CLI, and by
# docker compose for ${...} substitution in the compose files.
NODE_ENV=development

# MUST match static-auth-secret in coturn/coturn.conf.
TURN_SECRET=2285427
# Comma-separated ICE URLs handed to clients.
TURN_URLS=turn:localhost:3478
TURN_TTL=86400

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Host-side default. `docker compose up` (base + override) rewrites DB_HOST to
# the `db` service for the container; the same database is reachable from the
# host on localhost:5432, which is what `npm run start:dev`, `npm run seed
# -- --force` and the migration commands use.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# Enable TLS to the database (set true for managed/prod Postgres).
DB_SSL=false

# On-disk folder (dev) / bucket name (prod) holding template files.
GAMES_BUCKET=templates
